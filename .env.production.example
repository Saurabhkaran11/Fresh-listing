# Next.js web/API service (Vercel or the Node API host)
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://jobs.example.com
DATABASE_URL=postgresql://<runtime-user>:<password>@<host>/<database>?sslmode=require
AUTH_SECRET=<32-byte-random-secret>
AUTH_TRUST_HOST=true
AUTH_GOOGLE_CLIENT_ID=<oauth-client-id>
AUTH_GOOGLE_CLIENT_SECRET=<oauth-client-secret>

# Google Drive/Sheets integration
GOOGLE_CLIENT_ID=<drive-oauth-client-id>
GOOGLE_CLIENT_SECRET=<drive-oauth-client-secret>
GOOGLE_TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# Job providers and optional services
SERPAPI_API_KEY=<server-side-provider-key>
RESEND_API_KEY=<optional-email-provider-key>
EMAIL_FROM=Fresh Listings <jobs@example.com>
GEMINI_API_KEY=<optional-ai-key>
GEMINI_MODEL=gemini-2.0-flash

# Telegram and realtime
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_BOT_USERNAME=<bot-username-without-at>
TELEGRAM_WEBHOOK_SECRET=<long-random-secret>
REALTIME_SERVICE_URL=https://fresh-listings-realtime.onrender.com
REALTIME_SESSION_SECRET=<shared-hmac-secret>
REALTIME_EVENT_SECRET=<shared-event-secret>
REDIS_URL=rediss://<redis-user>:<password>@<redis-host>:<port>
CRON_SECRET=<long-random-secret>

# Observability
SENTRY_DSN=<optional-sentry-dsn>
OTEL_EXPORTER_OTLP_ENDPOINT=<optional-otlp-endpoint>
