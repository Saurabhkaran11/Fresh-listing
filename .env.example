# Required managed PostgreSQL connection. Use Neon’s pooled connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# NextAuth production session and Google sign-in.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Server-side live provider. Google Jobs results cover listings aggregated from
# multiple job boards, and each result records its reported portal/provider.
SEARCHAPI_API_KEY=

# Restricted job portals (LinkedIn, Indeed, Glassdoor, Built In, TrueUp) are
# native-search/manual until the provider grants written API/partner access.
# Never add portal passwords, browser cookies, MFA codes, or CAPTCHA tokens.

# Google OAuth web application credentials. Add the callback URL:
# https://YOUR-SITE-HOST/api/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 encoded (for example: openssl rand -base64 32)
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Daily digest provider (Resend-compatible HTTP API)
RESEND_API_KEY=
EMAIL_FROM=

# Optional AI Fit Analyzer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Telegram prompt search and daily notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Shared secrets for the separately hosted Socket.IO service and daily cron.
# Generate long random values; never expose these through NEXT_PUBLIC_* names.
REALTIME_SERVICE_URL=
REALTIME_SESSION_SECRET=
REALTIME_EVENT_SECRET=
REDIS_URL=
ALLOW_ANY_ORIGIN=false
CRON_SECRET=

# Socket.IO service only.
FRONTEND_ORIGIN=https://your-frontend.example.com
