# Server-side live provider. Google Jobs results cover multiple job boards.
SERPAPI_API_KEY=

# Google OAuth web application credentials. Add the callback URL:
# https://YOUR-SITE-HOST/api/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 encoded (for example: openssl rand -base64 32)
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Daily digest provider (Resend-compatible HTTP API)
RESEND_API_KEY=
EMAIL_FROM=

# Optional AI Fit Analyzer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
